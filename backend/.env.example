# VerifyChain Backend — copy this file to .env and fill in real values

# Database (local dev; production will use MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/verifychain

# Blockchain (zkSync Sepolia testnet)
ZKSYNC_SEPOLIA_RPC=https://sepolia.era.zksync.dev
GOVERNANCE_BOARD_ADDRESS=0x833C48E232174F849201fc58642bfdb41265D51e
CREDENTIAL_REGISTRY_ADDRESS=0x92fF1cB6177c6543E3ED358dcceBD7F7E9cBcBef

# Email (Gmail App Password, not your normal password)
EMAIL_USER=your-email@gmail.com
EMAIL_APP_PASSWORD=your-16-character-app-password

# URL baked into QR codes on certificates (no trailing slash)
FRONTEND_URL=http://localhost:5173